# ==========================================
# Backend environment — salin ke `.env`
# Jangan commit file `.env` asli.
# ==========================================

# Server
NODE_ENV=development
PORT=3001

# Database (MySQL / MariaDB)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/hotspot_db"

# CORS — origin frontend
FRONTEND_URL="http://localhost:5173"

# ==========================================
# WAJIB — minimal 16 karakter acak
# Jangan pakai nilai contoh ini di production.
# ==========================================
JWT_SECRET="change-me-min-16-chars-random"
JWT_REFRESH_SECRET="change-me-min-16-chars-random-2"
ENCRYPTION_KEY="change-me-min-16-chars-random-3"

# JWT expiry (opsional)
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ==========================================
# WhatsApp gateway (Baileys) — opsional
# Kredensial sesi disimpan di folder lokal, bukan di env.
# ==========================================
WA_AUTH_DIR="wa-auth"

# Redis (opsional — streaming monitoring multi-instance)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
