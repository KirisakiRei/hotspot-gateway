# Salin ke /opt/hotspot-gateway/backend/.env di VPS.
# Semua secret wajib diganti (min 16 karakter acak).

NODE_ENV=production
PORT=1708

DATABASE_URL="mysql://hotspot:GANTI_PASSWORD@127.0.0.1:3306/hotspot_db"

FRONTEND_URL="https://wifi.rekavia.com"
CORS_ORIGINS="https://wifi.rekavia.com"

JWT_SECRET="GANTI_MIN_16_KARAKTER_ACAK"
JWT_REFRESH_SECRET="GANTI_MIN_16_KARAKTER_ACAK_LAIN"
ENCRYPTION_KEY="GANTI_MIN_16_KARAKTER_ACAK_LAIN_2"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Fallback jika setting DB kosong. Host = IP MikroTik di tunnel WireGuard.
MIKROTIK_HOST="10.8.0.2"
MIKROTIK_PORT="8728"
MIKROTIK_USERNAME="api-hotspot"
MIKROTIK_PASSWORD=""

REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""
